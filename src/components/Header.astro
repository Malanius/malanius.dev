---
interface Props {
  active: 'home' | 'garden' | 'blog' | 'projects';
}

const { active } = Astro.props;

const items = [
  { id: 'home', label: 'home', href: '/' },
  { id: 'garden', label: 'garden', href: '/garden/' },
  { id: 'blog', label: 'blog', href: '/blog/' },
  { id: 'projects', label: 'projects', href: '/projects/' },
] as const;
---

<header>
  <a class="wordmark" href="/">malanius<span>.dev</span></a>
  <nav>
    {items.map((item) => (
      <a href={item.href} class:list={{ active: item.id === active }}>「{item.label}」</a>
    ))}
  </nav>
</header>

<style>
  header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 22px 40px;
    border-bottom: 1px solid var(--surface0);
    gap: 16px;
    flex-wrap: wrap;
  }

  .wordmark {
    color: var(--text);
    font-weight: 700;
    font-size: 16px;
  }

  .wordmark span {
    color: var(--mauve);
  }

  nav {
    display: flex;
    gap: 22px;
    font-size: 13px;
  }

  nav a {
    color: var(--overlay0);
  }

  nav a:hover {
    color: var(--lavender);
  }

  nav a.active {
    color: var(--text);
  }

  @media (max-width: 640px) {
    header {
      padding: 18px 20px;
    }

    nav {
      gap: 12px;
      font-size: 12px;
    }
  }
</style>
