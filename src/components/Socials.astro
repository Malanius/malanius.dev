---
import { socials } from '../data/socials';
---

<div class="socials">
  {socials.map((s) => (
    <a
      href={s.href}
      title={s.label}
      aria-label={s.label}
      rel="me"
      style={`color: ${s.color};`}
    >
      {s.svgPath ? (
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={s.svgPath} /></svg>
      ) : (
        <i class={s.icon}></i>
      )}
    </a>
  ))}
</div>

<style>
  .socials {
    display: flex;
    gap: 14px;
    align-items: center;
    font-size: 15px;
  }

  .socials a {
    display: inline-flex;
  }

  .socials svg {
    width: 1.15em;
    height: 1.15em;
    fill: currentColor;
  }

  .socials a:hover {
    color: var(--lavender) !important;
  }
</style>
