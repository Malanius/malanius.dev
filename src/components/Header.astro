---
interface Props {
  active: 'home' | 'garden' | 'blog' | 'projects' | 'skills';
}

const { active } = Astro.props;

const items = [
  { id: 'home', label: 'home', href: '/' },
  { id: 'blog', label: 'blog', href: '/blog/' },
  { id: 'projects', label: 'projects', href: '/projects/' },
  { id: 'skills', label: 'skills', href: '/skills/' },
] as const;
---

<header>
  <a class="wordmark" href="/">malanius<span>.dev</span></a>
  <nav>
    {items.map((item) => (
      <a href={item.href} class:list={{ active: item.id === active }}>「{item.label}」</a>
    ))}
    <button id="theme-toggle" aria-label="toggle color theme" title="mocha / latte">
      <span class="moon">「月」</span><span class="sun">「日」</span>
    </button>
  </nav>
</header>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'latte' ? 'mocha' : 'latte';
    document.documentElement.dataset.theme = next;
    localStorage.setItem('theme', next);
  });
</script>

<style>
  header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 22px 40px;
    border-bottom: 1px solid var(--surface0);
    gap: 16px;
    flex-wrap: wrap;
  }

  .wordmark {
    color: var(--text);
    font-weight: 700;
    font-size: 16px;
  }

  .wordmark span {
    color: var(--mauve);
  }

  nav {
    display: flex;
    gap: 22px;
    font-size: 13px;
  }

  nav a {
    color: var(--overlay0);
  }

  nav a:hover {
    color: var(--lavender);
  }

  nav a.active {
    color: var(--text);
  }

  #theme-toggle {
    font: inherit;
    background: none;
    border: none;
    padding: 0;
    color: var(--overlay0);
    cursor: pointer;
  }

  #theme-toggle:hover {
    color: var(--lavender);
  }

  /* show the current flavor's icon */
  #theme-toggle .sun,
  :global([data-theme='latte']) #theme-toggle .moon {
    display: none;
  }

  :global([data-theme='latte']) #theme-toggle .sun {
    display: inline;
  }

  @media (max-width: 640px) {
    header {
      padding: 18px 20px;
    }

    nav {
      gap: 12px;
      font-size: 12px;
    }
  }
</style>
