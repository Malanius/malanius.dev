---
import { nowPlaying } from '../lib/nowPlaying';

const items = await nowPlaying();
---

<div class="panel">
  <div class="panel-title">▶ now playing <span class="jp">「いま」</span></div>
  <div class="rows">
    {items.map((item) => (
      <div class="row">
        <span class="what">
          {item.emoji} {item.href ? <a href={item.href} title={item.title}>{item.title}</a> : item.title}
        </span>
        <span class="progress">{item.progress}</span>
      </div>
    ))}
  </div>
</div>

<style>
  .jp {
    color: var(--overlay0);
    font-weight: 400;
  }

  .rows {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 13px;
  }

  .row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }

  /* Long titles get cut off with … (full title on hover) */
  .what {
    color: var(--text);
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .what a {
    color: inherit;
  }

  .what a:hover {
    color: var(--lavender);
  }

  .progress {
    color: var(--overlay0);
    flex-shrink: 0;
  }
</style>
