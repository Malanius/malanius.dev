---
import { STAGES, type Stage } from '../lib/garden';

interface Props {
  stage: Stage;
}

const { stage } = Astro.props;
const meta = STAGES[stage];
---

<span class="stage-badge" style={`color: ${meta.color};`}>{`${meta.emoji} ${meta.label}`}</span>

<style>
  .stage-badge {
    background: var(--surface0);
    font-size: 11px;
    padding: 3px 9px;
    border-radius: 4px;
    white-space: nowrap;
  }
</style>
