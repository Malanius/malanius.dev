---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Highlighted nav item; omit on pages outside the menu */
  active?: 'home' | 'garden' | 'blog' | 'projects' | 'skills';
  /** RSS feed advertised in <head>; defaults to the all-posts feed */
  feed?: { title: string; href: string };
  /** Pin the header, page title (desktop) and current section's `.section-cmd` while scrolling */
  sticky?: boolean;
}

const {
  title,
  description = 'Developer, anime enjoyer, and collector of half-finished side projects.',
  active,
  feed = { title: 'malanius.dev', href: '/rss.xml' },
  sticky = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      document.documentElement.dataset.theme =
        localStorage.getItem('theme') ??
        (matchMedia('(prefers-color-scheme: light)').matches ? 'latte' : 'mocha');
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={feed.title} href={feed.href} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />
  </head>
  <body class:list={{ sticky }}>
    <div class="site">
      <Header active={active} />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
    <script>
      // Pinned bars on sticky pages stack under each other; their heights change when the header wraps
      if (document.body.classList.contains('sticky')) {
        const root = document.documentElement;
        const bars = [
          ['--sticky-header', document.querySelector('.site > header')],
          ['--sticky-title', document.querySelector('.page-title')],
        ] as const;
        const observer = new ResizeObserver(() => {
          for (const [name, el] of bars) {
            if (el) root.style.setProperty(name, `${el.getBoundingClientRect().height}px`);
          }
        });
        for (const [, el] of bars) if (el) observer.observe(el);
      }
    </script>
  </body>
</html>
