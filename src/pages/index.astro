---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NowPlaying from '../components/NowPlaying.astro';
import { monthDay } from '../lib/format';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const interests = ['anime', 'coding', 'games', 'making things', 'manga', 'music', 'pondering the universe', 'tech'];
---

<BaseLayout title="malanius.dev" active="home">
  <div class="home">
    <div class="hero">
      <div class="intro">
        <div class="path muted">~/home</div>
        <h1>hi, I'm malanius <span class="kaomoji">(⌐■_■)</span></h1>
        <p class="bio">
          Developer, anime enjoyer, and collector of half-finished side projects. I build
          serverless things on AWS for a living, make things for fun, and occasionally write about
          both, along with the odd musing about life and existence.
        </p>
        <p class="interests muted">
          $ cat interests.txt <span class="output">→ {interests.map((item, i) => (
            <><span class="item">{item}{i < interests.length - 1 && ' ·'}</span>{' '}</>
          ))}</span>
        </p>
      </div>
    </div>

    <div class="cards">
      <NowPlaying />
      <div class="panel">
        <div class="panel-title">✎ recent writing</div>
        <div class="posts">
          {posts.length === 0 && <span class="muted">first post is brewing. soon™</span>}
          {posts.map((post) => (
            <div class="post-row">
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              <span class="muted">{monthDay(post.data.date)}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .home {
    padding: 44px 40px 36px;
  }

  .hero {
    display: flex;
    gap: 28px;
    align-items: flex-start;
  }

  .intro {
    flex: 1;
  }

  .path {
    font-size: 13px;
    margin-bottom: 8px;
  }

  h1 {
    margin: 0 0 14px;
    font-size: 30px;
    font-weight: 700;
  }

  .kaomoji {
    color: var(--yellow);
  }

  .bio {
    margin: 0 0 10px;
    color: var(--subtext1);
    font-size: 14px;
    line-height: 1.7;
    max-width: 56ch;
    text-wrap: pretty;
  }

  .interests {
    margin: 0;
    font-size: 13px;
  }

  .output {
    color: var(--green);
  }

  /* Wrap between items, never inside one */
  .item {
    white-space: nowrap;
  }

  .cards {
    display: grid;
    /* minmax(0, …) so long content can't stretch a column past its half */
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin-top: 36px;
  }

  .posts {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 13px;
  }

  .post-row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }

  .post-row .muted {
    flex-shrink: 0;
  }

  @media (max-width: 720px) {
    .home {
      padding: 28px 20px;
    }

    .cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
