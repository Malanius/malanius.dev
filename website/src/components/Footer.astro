---
import Socials from './Socials.astro';

const year = new Date().getFullYear();
---

<footer>
  <span>© {year} malanius</span>
  <Socials />
  <span>built with ♥ and too much caffeine <span class="kaomoji">ᕕ( ᐛ )ᕗ</span></span>
</footer>

<style>
  footer {
    display: flex;
    justify-content: space-between;
    padding: 16px 40px;
    border-top: 1px solid var(--surface0);
    font-size: 12px;
    color: var(--overlay0);
    gap: 12px;
    flex-wrap: wrap;
  }

  .kaomoji {
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    footer {
      padding: 14px 20px;
    }
  }
</style>
