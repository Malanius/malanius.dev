---
const badges = [
  { text: 'MALANIUS.DEV', bg: 'var(--surface0)', color: 'var(--text)' },
  { text: 'POWERED BY VIM', bg: 'var(--crust)', color: 'var(--green)' },
  { text: 'CATPPUCCIN', bg: 'var(--mauve)', color: 'var(--crust)', bold: true },
  { text: 'ANIME WAS A MISTAKE', bg: 'var(--surface0)', color: 'var(--red)' },
];
---

<div class="badges-section">
  <div class="label">── friends &amp; badges ──</div>
  <div class="strip">
    {badges.map((b) => (
      <div
        class="badge"
        style={`background: ${b.bg}; color: ${b.color}; ${b.bold ? 'font-weight: 700;' : ''}`}
      >
        {b.text}
      </div>
    ))}
    <span class="hint">← webring / 88×31</span>
  </div>
</div>

<style>
  .label {
    color: var(--overlay0);
    font-size: 12px;
    margin-bottom: 10px;
  }

  .strip {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
  }

  .badge {
    width: 88px;
    height: 31px;
    border: 1px solid var(--surface1);
    font-size: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    line-height: 1.2;
    padding: 0 2px;
    image-rendering: pixelated;
  }

  .hint {
    color: var(--overlay0);
    font-size: 12px;
    margin-left: 8px;
  }
</style>
