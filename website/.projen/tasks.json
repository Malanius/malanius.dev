{
  "manifestVersion": 3,
  "env": {
    "PATH": "$(bun --eval \"console.log(process.env.PATH)\")"
  },
  "tasks": {
    "build": {
      "name": "build",
      "description": "Full release build",
      "steps": [
        {
          "spawn": "pre-compile"
        },
        {
          "spawn": "compile"
        },
        {
          "spawn": "post-compile"
        },
        {
          "spawn": "test"
        },
        {
          "spawn": "package"
        }
      ]
    },
    "compile": {
      "name": "compile",
      "description": "Only compile",
      "steps": [
        {
          "exec": "astro build"
        }
      ]
    },
    "default": {
      "name": "default",
      "description": "Synthesize project files",
      "steps": [
        {
          "exec": "bunx projen default",
          "cwd": ".."
        }
      ]
    },
    "dev": {
      "name": "dev",
      "description": "Run the dev server on http://localhost:4321",
      "steps": [
        {
          "exec": "astro dev"
        }
      ]
    },
    "install": {
      "name": "install",
      "description": "Install project dependencies and update lockfile (non-frozen)",
      "steps": [
        {
          "exec": "bun install"
        }
      ]
    },
    "install:ci": {
      "name": "install:ci",
      "description": "Install project dependencies using frozen lockfile",
      "steps": [
        {
          "exec": "bun install --frozen-lockfile"
        }
      ]
    },
    "package": {
      "name": "package",
      "description": "Creates the distribution package"
    },
    "post-compile": {
      "name": "post-compile",
      "description": "Runs after successful compilation"
    },
    "pre-compile": {
      "name": "pre-compile",
      "description": "Prepare the project for compilation"
    },
    "preview": {
      "name": "preview",
      "description": "Serve the built site from website/dist",
      "steps": [
        {
          "exec": "astro preview"
        }
      ]
    },
    "test": {
      "name": "test",
      "description": "Run tests"
    }
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.js and run \"bunx projen\"."
}
